# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── SMTP – Outlook/Hotmail ───────────────────────────────────────────────────
# Für Outlook/Hotmail: Konto-Passwort oder App-Passwort (2FA nötig)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=einfachanfrage@outlook.com
SMTP_PASS=DEIN_PASSWORT_HIER
SMTP_FROM="Einfach Anfrage <einfachanfrage@outlook.com>"

# ─── Empfänger für Kontaktformular der Landing Page ───────────────────────────
CONTACT_EMAIL=einfachanfrage@outlook.com

# ─── Fotograf-Fallback (wenn kein data-email am Script-Tag gesetzt) ───────────
PHOTOGRAPHER_EMAIL=fotograf@example.com
PHOTOGRAPHER_NAME=Meine Fotografie

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...              # öffentlicher Schlüssel
SUPABASE_SERVICE_KEY=eyJ...           # Service-Role-Key (geheim!) – für Bild-Uploads

# ─── Optional: Basis-URL (für Links in E-Mails) ───────────────────────────────
BASE_URL=http://localhost:3000
